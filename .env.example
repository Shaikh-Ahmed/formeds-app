# Copy to .env for local development. EXPO_PUBLIC_* values are inlined into the
# JS bundle at build time — never put secrets here.
#
# Local dev against a local backend (use your machine's LAN IP for devices):
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Production web builds get this from Vercel project env settings;
# production native builds get it from eas.json build.production.env.

# Optional: Sentry crash reporting (leave empty to disable)
EXPO_PUBLIC_SENTRY_DSN=
