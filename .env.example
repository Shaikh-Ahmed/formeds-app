# Copy to .env for local development. EXPO_PUBLIC_* values are inlined into the
# JS bundle at build time — never put secrets here.
#
# Local dev against a local backend.
#
# In development the HOST here is ignored and taken from Metro instead — see
# deriveApiBase() in src/utils/api.ts. That is deliberate: a pinned LAN IP goes
# stale every time DHCP reassigns the machine's address, and the app then spends
# 15s timing out against a host that no longer exists. Metro's address is always
# reachable, because the bundle just loaded over it.
#
# So only the scheme, PORT and any path below still matter in dev. Change the
# port here if your backend does not run on 8000.
#
# A non-local host (a staging or Render URL) is respected verbatim even in dev,
# so you can still point the app at a deployed backend.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Production web builds get this from Vercel project env settings;
# production native builds get it from eas.json build.production.env.

# Optional: Sentry crash reporting (leave empty to disable)
EXPO_PUBLIC_SENTRY_DSN=

# Optional: Sentry build-time symbol / source-map upload.
# Only needed once this project is onboarded to Sentry. app.config.js adds the
# Sentry config plugin only when BOTH of these are set — leaving them empty
# keeps the plugin out of the build entirely (and keeps `expo start` quiet).
# Runtime error reporting is controlled by EXPO_PUBLIC_SENTRY_DSN above and
# does not depend on these.
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN is a secret: set it as an EAS secret or a local shell
# variable. Never commit it, and never add it to app.config.js.
